unit A { health: 50, attack: 5, defense: 1, speed: 3 }
unit B { health: 50, attack: 5, defense: 1, speed: 3 }
on turn A {
	deal  to nearest(enemy)
}
party P = [A]
party Q = [B]
battle: [P, Q]
/* The deal has a chain of exactly 10000 terms, which is the deepest expression that the parser accepts (the simulation refuses it later: it evaluates at most 2000 levels). */
