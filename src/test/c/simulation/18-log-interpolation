unit Hero { health: 30, attack: 5, defense: 1, speed: 6, abilities: [Slash] }
unit Goblin { health: 12, attack: 2, defense: 2, speed: 4 }

ability Slash on target: enemy {
	deal self.attack - target.defense to target
	log "{self} (attack {self.attack}, speed {self.speed}) hits {target} (defense {target.defense}, health {target.health})"
}

on turn Hero {
	use Slash on nearest(enemy)
}

party Heroes = [Hero]
encounter Goblins = [Goblin]

battle: [Heroes, Goblins]
