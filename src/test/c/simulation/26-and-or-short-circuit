unit Hero { health: 10, attack: 0, defense: 0, speed: 5 }
unit Dummy { health: 10, attack: 0, defense: 0, speed: 1 }

on turn Hero {
	if (self.attack > 0 and 10 / self.attack > 1) {
		log "and: both sides held"
	} else {
		log "and: the left side stopped it"
	}
	if (self.attack == 0 or 10 / self.attack > 1) {
		log "or: the left side was enough"
	} else {
		log "or: the right side decided"
	}
	if (self.health > 0 and 100 / self.health > 5) {
		log "and: the right side was evaluated"
	}
	if (self.health < 0 or 100 / self.health > 5) {
		log "or: the right side was evaluated"
	}
	if (nearest(ally).health > 0 and 10 / self.attack > 1) {
		log "never"
	}
	if (nearest(ally).health > 0 or 10 / self.attack > 1) {
		log "never"
	}
	if (self.health > 0 and nearest(ally).health > 0) {
		log "never"
	}
	if (self.health < 0 or nearest(ally).health > 0) {
		log "never"
	}
}

party Heroes = [Hero]
encounter Dummies = [Dummy]

battle: [Heroes, Dummies]
